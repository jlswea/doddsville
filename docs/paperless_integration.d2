direction: right

title: {
  label: dv CLI - Paperless-ngx Integration
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# Components
cli: {
  label: dv CLI
  shape: rectangle
  style.fill: "#e3f2fd"

  commands: {
    label: Commands
    shape: text
    style.font-size: 12
  }

  add: "dv add ... --doc"
  list: "dv list"
  config: "dv config check"
}

sqlite: {
  label: SQLite Database
  shape: cylinder
  style.fill: "#fff3e0"

  transaction: {
    shape: sql_table
    id: int {constraint: primary_key}
    account: int
    type: text
    date: date
  }

  transaction_document: {
    shape: sql_table
    id: int {constraint: primary_key}
    transaction_id: int {constraint: foreign_key}
    paperless_id: int
  }

  transaction_document.transaction_id -> transaction.id
}

paperless: {
  label: Paperless-ngx Server
  shape: rectangle
  style.fill: "#e8f5e9"

  api: {
    label: REST API
    shape: hexagon
    style.fill: "#c8e6c9"
  }

  endpoints: {
    label: |md
      - POST /api/documents/post_document/
      - GET /api/documents/{id}/
      - GET /api/tasks/
    |
    shape: text
    style.font-size: 11
  }

  storage: {
    label: Document Storage
    shape: cylinder
    style.fill: "#a5d6a7"
  }

  api -> storage: stores
}

config: {
  label: ~/.doddsville/config
  shape: document
  style.fill: "#fce4ec"

  settings: |md
    paperless_url=http://...
    paperless_token=xxx
  |
}

# Flows
cli -> sqlite: "Store transaction\n& document links" {
  style.stroke: "#1976d2"
}

cli -> paperless.api: "1. Upload document\n2. Verify document\n3. Check health" {
  style.stroke: "#388e3c"
}

paperless.api -> cli: "Return document ID" {
  style.stroke: "#388e3c"
  style.stroke-dash: 3
}

cli -> config: "Read credentials" {
  style.stroke: "#c2185b"
  style.stroke-dash: 3
}

# Flow description
flow: {
  label: |md
    ## Flow: Adding a transaction with document

    1. User runs `dv add buy ... --doc ./receipt.pdf`
    2. CLI reads paperless credentials from config
    3. CLI uploads document to paperless API
    4. Paperless returns document ID
    5. CLI inserts transaction into SQLite
    6. CLI links document ID in transaction_document table
  |
  shape: text
  near: bottom-center
  style.font-size: 12
}
